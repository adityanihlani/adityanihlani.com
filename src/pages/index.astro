---
const name = 'Aditya Nihlani';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Placeholder only: keeps search engines from indexing an empty site.
         Remove this line when the real content goes live. -->
    <meta name="robots" content="noindex" />
    <title>{name}</title>
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='13' font-size='13'>A</text></svg>"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main>
      <header>
        <h1>{name}</h1>
        <p class="soon">Site under construction.</p>
      </header>

      <p class="label"><span class="dot"></span> Latest</p>
      <a class="post" href="/blog/raspberry-pi-smart-home/">
        <img src="/images/pi4-top.jpg" alt="A Raspberry Pi 4 Model B board" width="1920" height="1282" />
        <div class="body">
          <span class="kicker">Home automation · 5 min read</span>
          <span class="title">
            How a simple <em>Raspberry Pi</em> computer got me into the best hobby I’ve ever had
          </span>
          <span class="read">Read the story <b>→</b></span>
        </div>
      </a>
    </main>

    <style>
      :root {
        --bg: #0b0d0c;
        --bg2: #121513;
        --fg: #ece9e1;
        --muted: #9aa19d;
        --line: rgba(236, 233, 225, 0.14);
        --accent: #7bd88f;
      }
      @media (prefers-color-scheme: light) {
        :root {
          --bg: #f6f3ec;
          --bg2: #ece7db;
          --fg: #16191a;
          --muted: #5c6360;
          --line: rgba(22, 25, 26, 0.16);
          --accent: #1f7a3c;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; min-height: 100vh; background: var(--bg); color: var(--fg);
        font-family: 'Inter', ui-sans-serif, system-ui, sans-serif; -webkit-font-smoothing: antialiased;
        background-image: radial-gradient(60rem 30rem at 80% -10%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 70%);
        background-repeat: no-repeat;
      }
      main { max-width: 760px; margin: 0 auto; padding: clamp(3rem, 12vh, 7rem) 1.5rem 4rem; }
      h1 { margin: 0; font-family: 'Fraunces', Georgia, serif; font-weight: 400; font-size: clamp(2.6rem, 8vw, 4.5rem); letter-spacing: -0.03em; line-height: 1; }
      .soon { margin: 0.9rem 0 0; color: var(--muted); font-size: 1rem; }
      .label {
        display: flex; align-items: center; gap: 0.6rem; margin: 4rem 0 1rem;
        font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted);
      }
      .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
      .post {
        display: block; color: inherit; text-decoration: none; border: 1px solid var(--line); border-radius: 22px; overflow: hidden;
        background: var(--bg2); transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
      }
      .post:hover { transform: translateY(-4px); border-color: var(--accent); box-shadow: 0 30px 60px -30px color-mix(in srgb, var(--accent) 45%, transparent); }
      .post img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 8; object-fit: cover; }
      .body { display: flex; flex-direction: column; gap: 0.8rem; padding: 1.6rem 1.8rem 1.8rem; }
      .kicker { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
      .title { font-family: 'Fraunces', Georgia, serif; font-size: clamp(1.5rem, 4.4vw, 2.1rem); line-height: 1.15; letter-spacing: -0.02em; }
      .title em { color: var(--accent); }
      .read { color: var(--accent); font-weight: 500; font-size: 0.95rem; }
      .read b { display: inline-block; transition: transform 0.25s ease; }
      .post:hover .read b { transform: translateX(5px); }
    </style>
  </body>
</html>
